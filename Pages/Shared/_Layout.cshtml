<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Laborator4_5</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Laborator4_5.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="container-fluid">
        <!-- Meniu Navigație -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Portal Știri</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Acasă</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="News" asp-action="Politic">Politic</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="News" asp-action="Sport">Sport</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">Despre</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
                </ul>

                <!-- Bara de căutare -->
                <form class="d-flex ms-auto">
                    <input id="cautare" class="form-control form-control-sm me-2" type="search" placeholder="Caută..." aria-label="Search" style="width: 150px;">
                    <button class="btn btn-outline-light btn-sm" type="submit">Caută</button>
                </form>
            </div>
        </nav>

        

        <!-- Banner -->
        <div class="container text-center mt-4">
            <h1 class="display-4">Banner - Logo</h1>
            <p class="lead">Slogan al portalului</p>
        </div>

        <!-- Conținut principal -->
        <div class="container mt-4">
            <div class="row g-4">
                <!-- 'g-4' adaugă gap între coloane și rânduri -->
                <div class="col-lg-8">
                    <section id="news">
                        <h2>Știri Recente</h2>
                        @RenderBody()
                    </section>
                </div>
                <div class="col-lg-4">
                    <section id="categories" class="card p-3">
                        <h4>Categorii</h4>
                        <ul class="list-group">
                            <li class="list-group-item">Politic</li>
                            <li class="list-group-item">Sport</li>
                            <li class="list-group-item">Economie</li>
                            <li class="list-group-item">Tech</li>
                        </ul>
                    </section>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <footer class="bg-dark text-white text-center py-3 mt-4">
            <p>&copy; @DateTime.Now.Year - Laborator4_5</p>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
